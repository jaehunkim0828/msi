generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model contact_inquiries {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              String
  product           String?
  company           String
  department        String?
  manager           String
  email             String
  content           String
  created_at        DateTime @default(now())
  attachments       String?
  budget_range      String?
  current_equipment String?
  equipment_model   String?
  expected_timeline String?
  inquiry_type      String?
  install_location  String?
  issue_date        String?
  issue_type        String?
  line_status       String?
  phone             String
  position          String?
  priority          String?
  production_volume String?
  serial_number     String?

  @@index([created_at(sort: Desc)])
  @@index([email])
  @@index([priority])
  @@index([type])
}

model users {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username   String   @unique
  password   String
  created_at DateTime @default(now())
}
